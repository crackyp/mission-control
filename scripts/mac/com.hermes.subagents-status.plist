<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hermes subagent exporter (2026-09-24). Reads ~/.hermes/state.db READ-ONLY and
  writes shared/bernie/subagents.json every 5s for Mission Control's Agents tab
  (running delegate_task children + last 24h, with reasoning/tool timelines).

  Same shape as com.hermes.llamaswap-status: a LaunchAgent (the SMB share is
  mounted in the GUI session), and KeepAlive is NOT relied on — this Mac does
  not service KeepAlive respawns, so the loop guards every iteration itself.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.subagents-status</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kev/.hermes/hermes-agent/venv/bin/python3</string>
        <string>/Users/kev/ai/scripts/hermes-subagents-export.py</string>
        <string>--loop</string>
        <string>5</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Users/kev/ai/logs/subagents-status.launchd.err</string>
</dict>
</plist>
